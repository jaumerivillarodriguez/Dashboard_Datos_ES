table _Medidas
	lineageTag: 662da2b8-bb3e-41d1-ac0b-e37aa6cf9e49

	measure '_Ambos sexos aux' = ```
			
			    SELECTEDVALUE(M_SEXO[EsTotal]) = TRUE()
			```
		formatString: """TRUE"";""TRUE"";""FALSE"""
		displayFolder: _Auxiliares
		lineageTag: dd7d60d6-580f-4083-8510-dc4bd348dfe5

	measure '_Año base indice aux' = ```
			
			VAR hay2015 =
			    CALCULATE(
			        COUNTROWS(M_CALENDARIO),
			        ALL (M_CALENDARIO), M_CALENDARIO[Año] = 2015     )
			
			RETURN 
			    IF (hay2015 > 0,
			        2015,
			         CALCULATE(
			            MIN(M_CALENDARIO[Año]),
			            ALL(M_CALENDARIO)
			        )
			    )
			```
		displayFolder: _Auxiliares
		lineageTag: 915d2f23-d8d7-43f6-acf3-7014f3be0698

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Salario medio (anuales)' =
			
			VAR noSexoSel = NOT ISFILTERED(M_SEXO[Sexo])            -- TRUE si no hay filtro de sexo
			VAR noCCAA_Sel = NOT ISFILTERED(M_CCAA[CCAA])           -- TRUE si no hay filtro de CCAA
			VAR isTotalSel = [_Ambos sexos aux]                     -- TRUE si el filtro actual es Ambos sexos
			RETURN
			IF(
			    noSexoSel || isTotalSel || noCCAA_Sel,               -- Si no hay selección de sexo, o es Ambos, o no hay CCAA
			    CALCULATE(
			        AVERAGE(H_MEDIA_SUELDOS_ANUALES[Salario Medio Anual]),
			        KEEPFILTERS(M_SEXO[EsTotal] = TRUE()),          -- fuerza Ambos sexos
			        KEEPFILTERS(M_CCAA[CCAA] = "Total Nacional")          -- fuerza Nacional
			    ),
			    CALCULATE(
			        AVERAGE(H_MEDIA_SUELDOS_ANUALES[Salario Medio Anual]),
			        KEEPFILTERS(M_SEXO[EsTotal] = FALSE()),         -- si hay H o M, excluye Ambos sexos
			        KEEPFILTERS(M_CCAA[CCAA] <> "Total Nacional")         -- excluye Nacional si está seleccionada
			    )
			)
		displayFolder: Salarios / Vivienda / IPC\Salarios
		lineageTag: 7d460efd-1d02-4c10-ad7b-086a2c7ea945

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Salario medio H (anuales)' =
			
			VAR noCCAASel = NOT ISFILTERED(M_CCAA[CCAA])
			RETURN
			IF(
			    noCCAASel,
			    CALCULATE(
			        AVERAGE(H_MEDIA_SUELDOS_ANUALES[Salario Medio Anual]),
			        REMOVEFILTERS(M_SEXO),
			        KEEPFILTERS(H_MEDIA_SUELDOS_ANUALES[Sexo] = "Hombres"),
			        KEEPFILTERS(M_CCAA[CCAA] = "Total Nacional")   -- por defecto, Nacional
			    ),
			    CALCULATE(
			        AVERAGE(H_MEDIA_SUELDOS_ANUALES[Salario Medio Anual]),
			        REMOVEFILTERS(M_SEXO),
			        KEEPFILTERS(H_MEDIA_SUELDOS_ANUALES[Sexo] = "Hombres"),
			        KEEPFILTERS(M_CCAA[CCAA] <> "Total Nacional")  -- si el usuario elige CCAA y además está Nacional, se excluye
			    )
			)
		displayFolder: Salarios / Vivienda / IPC\Salarios
		lineageTag: 0e836ea6-29d5-4415-9aac-4a09b82d2a5b

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Salario medio M (anuales)' = ```
			
			VAR noCCAASel = NOT ISFILTERED(M_CCAA[CCAA])
			RETURN
			IF(
			    noCCAASel,
			    CALCULATE(
			        AVERAGE(H_MEDIA_SUELDOS_ANUALES[Salario Medio Anual]),
			        REMOVEFILTERS(M_SEXO),
			        KEEPFILTERS(H_MEDIA_SUELDOS_ANUALES[Sexo] = "Mujeres"),
			        KEEPFILTERS(M_CCAA[CCAA] = "Total Nacional")   -- por defecto, Nacional
			    ),
			    CALCULATE(
			        AVERAGE(H_MEDIA_SUELDOS_ANUALES[Salario Medio Anual]),
			        REMOVEFILTERS(M_SEXO),
			        KEEPFILTERS(H_MEDIA_SUELDOS_ANUALES[Sexo] = "Mujeres"),
			        KEEPFILTERS(M_CCAA[CCAA] <> "Total Nacional")  -- si el usuario elige CCAA y además está Nacional, se excluye
			    )
			)
			
			```
		displayFolder: Salarios / Vivienda / IPC\Salarios
		lineageTag: 185657be-59be-48b5-a41a-a99f2e9fba39

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Brecha € (anuales)' = ```
			
			[Salario medio H (anuales)] - [Salario medio M (anuales)]
			
			```
		formatString: #,0.00\ "€";-#,0.00\ "€";#,0.00\ "€"
		displayFolder: Salarios / Vivienda / IPC\Salarios
		lineageTag: 3014414a-8eaa-4047-b209-1be52050a60d

	measure 'Brecha % (anuales)' = ```
			
			DIVIDE([Brecha € (anuales)], [Salario medio H (anuales)])
			
			```
		formatString: 0.00\ %;-0.00\ %;0.00\ %
		displayFolder: Salarios / Vivienda / IPC\Salarios
		lineageTag: 79190d9e-23cf-4cc2-b6e9-11b3b16d91ed

	measure 'Índice salario (2015->100)' = ```
			
			VAR baseYear = [_Año base indice aux]
			VAR baseVal =
			    CALCULATE(
			        [Salario medio (anuales)],
			        ALL(M_CALENDARIO),                     -- ignora tiempo para ir al año base
			        M_CALENDARIO[Año] = baseYear
			    )
			RETURN
			DIVIDE([Salario medio (anuales)], baseVal) * 100
			
			```
		displayFolder: Salarios / Vivienda / IPC\Salarios
		lineageTag: 1041d8ae-7e2e-4ab2-af10-125de0c7b584

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Salario medio (edad)' = ```
			
			VAR noSexoSel  = NOT ISFILTERED(M_SEXO[Sexo])
			VAR isAmbosSel = [_Ambos sexos aux]
			RETURN
			IF(
			    noSexoSel || isAmbosSel,                           -- por defecto: Ambos sexos
			    CALCULATE(
			        AVERAGE(H_MEDIA_SUELDOS_EDAD[Salario medio anual]),
			        KEEPFILTERS(M_SEXO[EsTotal] = TRUE())
			    ),
			    CALCULATE(                                         -- si eligen H o M, excluye la fila agregada
			        AVERAGE(H_MEDIA_SUELDOS_EDAD[Salario medio anual]),
			        KEEPFILTERS(M_SEXO[EsTotal] = FALSE())
			    )
			)
			
			```
		displayFolder: Salarios / Vivienda / IPC\Salarios
		lineageTag: 127892bf-3394-456c-ac66-3cbd1dcc3ebf

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Salario medio (actividad)' =
			
			VAR noSexoSel  = NOT ISFILTERED(M_SEXO[Sexo])
			VAR isAmbosSel = [_Ambos sexos aux]
			RETURN
			IF(
			    noSexoSel || isAmbosSel,                           -- por defecto: Ambos sexos
			    CALCULATE(
			        AVERAGE(H_SUELDOS_POR_ACTIVIDAD[Salario]),
			        KEEPFILTERS(M_SEXO[EsTotal] = TRUE())
			    ),
			    CALCULATE(                                         -- si eligen H o M, excluye la fila agregada
			        AVERAGE(H_SUELDOS_POR_ACTIVIDAD[Salario]),
			        KEEPFILTERS(M_SEXO[EsTotal] = FALSE())
			    )
			)
		displayFolder: Salarios / Vivienda / IPC\Salarios
		lineageTag: 8802c282-0128-4723-bf7b-dd52da9fb8fb

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure '% IPV variación desde 2015' = ```
			
			VAR tipoSel =
			    SELECTEDVALUE(H_VIVIENDAS[Tipo Vivienda], "General")
			VAR base2015 =
			    CALCULATE(
			        AVERAGE(H_VIVIENDAS[Valor]),        -- media de los trimestres de 2015
			        ALL(M_CALENDARIO),                  -- ignora tiempo para ir a 2015
			        M_CALENDARIO[Año] = 2015,
			        KEEPFILTERS(H_VIVIENDAS[Indicador] = "Índice"),
			        KEEPFILTERS(H_VIVIENDAS[Tipo Vivienda] = tipoSel)
			        -- CCAA se toma del slicer (dinámico)
			    )
			VAR currentVal =
			    CALCULATE(
			        AVERAGE(H_VIVIENDAS[Valor]),
			        KEEPFILTERS(H_VIVIENDAS[Indicador] = "Índice"),
			        KEEPFILTERS(H_VIVIENDAS[Tipo Vivienda] = tipoSel)
			    )
			RETURN
			DIVIDE(currentVal - base2015, base2015) 
			
			```
		formatString: 0.00\ %;-0.00\ %;0.00\ %
		displayFolder: Salarios / Vivienda / IPC\Vivienda
		lineageTag: ca0320d7-e212-4ca5-ab1d-4af1b9eedb5e

	measure '% Salario variación desde 2015' =
			
			VAR lastYear = [_Ultimo año salario]
			VAR ctxYear  = MAX(M_CALENDARIO[Año])                          -- funciona tanto si el eje es Año como Mes
			VAR baseVal  =
			    CALCULATE(
			        [Salario medio (anuales)],
			        ALL(M_CALENDARIO),
			        M_CALENDARIO[Año] = 2015
			    )
			RETURN
			IF(
			    ctxYear > lastYear,
			    BLANK(),                                                   -- oculta puntos > último año con datos
			    DIVIDE([Salario medio (anuales)] - baseVal, baseVal)
			)
		formatString: 0.00\ %;-0.00\ %;0.00\ %
		displayFolder: Salarios / Vivienda / IPC\Salarios
		lineageTag: 85fcffe0-e650-4fd9-bac6-2181e49e33ec

	measure '% IPC variación desde 2015' =
			
			VAR base2015 =
			    CALCULATE(
			        AVERAGE(H_IPC[Índice general]),      -- media de los 12 meses de 2015
			        ALL(M_CALENDARIO), M_CALENDARIO[Año] = 2015
			    )
			RETURN
			DIVIDE(
			    AVERAGE(H_IPC[Índice general]) - base2015,  -- diferencia vs 2015
			    base2015                                    -- normaliza a base
			)
		formatString: 0.00\ %;-0.00\ %;0.00\ %
		displayFolder: Salarios / Vivienda / IPC\IPC
		lineageTag: 94c5f2af-42e2-4141-8650-7e63ae4e1da7

	measure '% Salario real variación desde 2015' =
			
			VAR lastYear = [_Ultimo año salario]
			VAR ctxYear  = MAX(M_CALENDARIO[Año])
			RETURN
			IF(
			    ctxYear > lastYear,
			    BLANK(),
			    [% Salario variación desde 2015] - [% IPC variación desde 2015]
			)
		formatString: 0.00\ %;-0.00\ %;0.00\ %
		displayFolder: Salarios / Vivienda / IPC\Salarios
		lineageTag: 1ab71039-4e05-4d43-9ff3-1f6dd7e9759f

	measure '_Ultimo año salario' =
			
			MAXX(
			    FILTER(
			        ALL(M_CALENDARIO),
			        NOT ISBLANK( CALCULATE([Salario medio (anuales)]) )   -- sólo años con dato real
			    ),
			    M_CALENDARIO[Año]
			)
			-- Encuentra el último año con salario disponible (dinámico por filtros de CCAA/sexo)
		formatString: 0
		displayFolder: _Auxiliares
		lineageTag: de7cbaac-1a62-4d68-9e19-ae7fd9e619fb

