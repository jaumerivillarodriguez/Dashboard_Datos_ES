	measure 'Brecha % YoY (ftm)' = ```
			
			VAR diff = [Brecha % YoY]
			RETURN
			SWITCH(
			    TRUE(),
			    ISBLANK(diff), BLANK(),
			    diff < 0, "▲ " & FORMAT(ABS(diff), "-0.00%"), 
			    diff > 0, "▼ " & FORMAT(ABS(diff), "0.00%"),   
			    "=" & FORMAT(0, "0%")                         
			)
			```
		displayFolder: Salarios / Vivienda / IPC\_Temporales
		lineageTag: a2030d6e-7a7b-45e0-b181-544384372dc3

	measure 'Año max eje x IPC' = ```
			
			    CALCULATE(
			        YEAR(MAX(H_IPC[Fecha]))
			    )
			```
		formatString: 0
		displayFolder: Salarios / Vivienda / IPC\_Temporales
		lineageTag: 18630a6e-8304-414a-9305-d1f17129e64a

	measure '% IPC YoY' =
			
			VAR cur  = AVERAGE(H_IPC[Índice general])
			VAR prev =
			    CALCULATE(
			        AVERAGE(H_IPC[Índice general]),
			        DATEADD(M_CALENDARIO[Fecha], -1, YEAR)   -- mismo periodo del año anterior
			    )
			RETURN
			IF( ISBLANK(prev), BLANK(), DIVIDE(cur - prev, prev) )
		displayFolder: Salarios / Vivienda / IPC\IPC
		lineageTag: 54897e5d-3a94-4876-8175-08207972e1f5

