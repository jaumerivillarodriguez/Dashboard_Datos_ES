	measure '% Variación anual IPC' = ```
			
			VAR prevYear =
			    CALCULATE(
			        [% IPC variación desde 2015],
			        DATEADD(M_CALENDARIO[Fecha], -1, YEAR)
			    )
			RETURN
			[% IPC variación desde 2015] - prevYear
			
