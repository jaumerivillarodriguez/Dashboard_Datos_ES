	measure '% Variación del valor adquisitivo' =
			
			VAR lastYear = [_Ultimo año salario]
			VAR ctxYear  = MAX(M_CALENDARIO[Año])
			
			RETURN
				IF(
				    ctxYear > lastYear,
				    BLANK(),
				    [% Variación salario medio] - [% IPC variación desde 2015]
				)
		formatString: 0.00\ %;-0.00\ %;0.00\ %
		displayFolder: Salarios / Vivienda / IPC\Salarios
		lineageTag: b1e0e075-d870-48d9-8ffc-442e9709d8c4

	measure '% Salario YoY (fmt)' =
			
			VAR yoy = [% Salario YoY]                       -- reutiliza la medida numérica
			RETURN
			IF(
			    ISBLANK(yoy),
			    BLANK(),
			    SWITCH(                                      -- símbolo antes del número
			        TRUE(),
			        yoy > 0, "▲ ",
			        yoy < 0, "▼ -",
			        "= "
			    ) &
			    FORMAT(yoy, "0.00%")
			)
		displayFolder: Salarios / Vivienda / IPC\_Temporales
		lineageTag: 160b8be1-7a3d-4006-8952-016ca3bf85ef

	measure 'YoY txt' =
			
			VAR selYear = MAX(M_CALENDARIO[Año])
			RETURN
			"YoY | " & selYear & " vs " & selYear - 1
		displayFolder: Salarios / Vivienda / IPC\_Temporales
		lineageTag: 714da24d-d46e-4d85-88cd-51b8fa0463a9

