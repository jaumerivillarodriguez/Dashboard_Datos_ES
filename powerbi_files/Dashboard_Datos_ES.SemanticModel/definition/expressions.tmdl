expression Fecha_Maxima =
		let
		    MaxFechaViviendas = Table.Max(H_VIVIENDAS, "Fecha")[Fecha],
		    MaxFechaMediaSueldos = Table.Max(H_MEDIA_SUELDOS_ANUALES, "Fecha")[Fecha],
		    MaxFechaSueldosActividad = Table.Max(H_SUELDOS_POR_ACTIVIDAD, "Fecha")[Fecha],
		    MaxFechaSueldosEdad = Table.Max(H_MEDIA_SUELDOS_EDAD, "Fecha")[Fecha],
		    ListaFechas = {MaxFechaViviendas, MaxFechaMediaSueldos, MaxFechaSueldosActividad},
		    MaxGlobal = List.Max(ListaFechas)
		in
		    MaxGlobal
